// ─────────────────────────────────────────────────────────────────────────────
// TENANT DATA-PLANE SCHEMA (physical database-per-tenant)
//
// This schema is migrated into EACH tenant's dedicated physical Postgres
// database by TenantDatabaseProvisioningService. It holds only tenant payload
// data — no control-plane tables (tenants/projects/users/connector_instances
// live in the control-plane `KPI` DB, described by ../schema.prisma).
//
// KEY DIFFERENCE vs the control-plane schema: there are NO foreign keys to
// control-plane tables. `site_id` (project) and `connector_instance_id` are
// carried as plain indexed columns (soft references) because Postgres cannot
// enforce a foreign key across two physical databases. There is deliberately NO
// `tenant_id` column: each tenant has its own physical database, so the value
// would be constant across every row and carries no information. Foreign keys
// that stay WITHIN the data plane (order→snapshot, customer→session→event) are
// preserved.
//
// @map names, column types and indexes are kept identical to the control-plane
// schema so existing `prisma.<model>` query shapes port to the tenant client
// unchanged.
// ─────────────────────────────────────────────────────────────────────────────

datasource db {
  provider = "postgresql"
  url      = env("TENANT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../../../../node_modules/.prisma/tenant-client"
}

model CanonicalOrder {
  id                  String    @id @db.VarChar(36)
  siteId              String    @map("site_id") @db.VarChar(255)
  connectorInstanceId String?   @map("connector_instance_id") @db.VarChar(36)
  orderId             String    @map("order_id") @db.VarChar(255)
  externalReferenceId String?   @map("external_ref_id") @db.VarChar(255)
  sourceSystem        String    @map("source_system") @db.VarChar(255)
  channel             String    @db.VarChar(50)
  lifecycleState      String    @map("lifecycle_state") @db.VarChar(50)
  normalizedStatus    String    @map("normalized_status") @db.VarChar(50)
  currency            String    @db.VarChar(10)
  totalAmount         Decimal   @map("total_amount") @db.Decimal(20, 4)
  taxAmount           Decimal?  @map("tax_amount") @db.Decimal(20, 4)
  discountAmount      Decimal?  @map("discount_amount") @db.Decimal(20, 4)
  paidAmount          Decimal?  @map("paid_amount") @db.Decimal(20, 4)
  refundedAmount      Decimal?  @map("refunded_amount") @db.Decimal(20, 4)
  placedAt            DateTime  @map("placed_at")
  paidAt              DateTime? @map("paid_at")
  shippedAt           DateTime? @map("shipped_at")
  deliveredAt         DateTime? @map("delivered_at")
  mappingVersion      String    @map("mapping_version") @db.VarChar(20)
  ingestionEventId    String?   @map("ingestion_event_id") @db.VarChar(36)
  // Resolved golden-record owner of this order (IdentityResolver). Nullable: guest
  // checkouts and unmatched offline rows legitimately have none. No FK — profiles
  // are deleted on merge, and orders must survive that.
  customerProfileId   String?   @map("customer_profile_id") @db.VarChar(36)
  metadata            Json      @default("{}")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @map("updated_at")

  snapshots OrderSnapshot[]
  events    OrderEvent[]

  @@index([siteId], map: "idx_order_site")
  @@index([connectorInstanceId], map: "idx_order_connector")
  @@index([orderId], map: "idx_order_source_id")
  @@index([lifecycleState], map: "idx_order_lifecycle")
  @@index([placedAt], map: "idx_order_placed_ts")
  @@index([connectorInstanceId, customerProfileId], map: "idx_order_customer_profile")
  @@map("canonical_orders")
}

model CanonicalProduct {
  id                  String    @id @db.VarChar(36)
  siteId              String    @map("site_id") @db.VarChar(255)
  connectorInstanceId String?   @map("connector_instance_id") @db.VarChar(36)
  productId           String    @map("product_id") @db.VarChar(255)
  sourceSystem        String    @map("source_system") @db.VarChar(255)
  name                String    @db.VarChar(255)
  sku                 String?   @db.VarChar(255)
  inventory           Int?      @default(0)
  price               Decimal?  @db.Decimal(20, 4)
  sourceUpdatedAt     DateTime? @map("source_updated_at")
  metadata            Json      @default("{}")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @map("updated_at")

  @@unique([siteId, sourceSystem, productId], map: "uq_product_source_ref")
  @@index([siteId], map: "idx_product_site")
  @@index([connectorInstanceId], map: "idx_product_connector")
  @@map("canonical_products")
}

model CanonicalProductCategory {
  id                  String    @id @db.VarChar(36)
  siteId              String    @map("site_id") @db.VarChar(255)
  connectorInstanceId String?   @map("connector_instance_id") @db.VarChar(36)
  productId           String    @map("product_id") @db.VarChar(255)
  sourceSystem        String    @map("source_system") @db.VarChar(255)
  categoryId          String?   @map("category_id") @db.VarChar(255)
  categoryName        String    @map("category_name") @db.VarChar(255)
  categoryPath        String?   @map("category_path") @db.Text
  isPrimary           Boolean   @default(false) @map("is_primary")
  metadata            Json      @default("{}")
  sourceUpdatedAt     DateTime? @map("source_updated_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @map("updated_at")

  @@unique([siteId, sourceSystem, productId, categoryName], map: "uq_product_category_source_ref")
  @@index([siteId], map: "idx_product_category_site")
  @@index([connectorInstanceId], map: "idx_product_category_connector")
  @@index([productId], map: "idx_product_category_product")
  @@index([categoryName], map: "idx_product_category_name")
  @@map("canonical_product_categories")
}

model CanonicalCheckout {
  id                   String    @id @db.VarChar(36)
  siteId               String    @map("site_id") @db.VarChar(255)
  connectorInstanceId  String?   @map("connector_instance_id") @db.VarChar(36)
  checkoutId           String    @map("checkout_id") @db.VarChar(255)
  sourceSystem         String    @map("source_system") @db.VarChar(255)
  token                String?   @db.VarChar(255)
  customerId           String?   @map("customer_id") @db.VarChar(36)
  customerEmail        String?   @map("customer_email") @db.VarChar(255)
  status               String    @db.VarChar(50)
  currency             String    @db.VarChar(10)
  subtotalAmount       Decimal?  @map("subtotal_amount") @db.Decimal(20, 4)
  totalAmount          Decimal   @map("total_amount") @db.Decimal(20, 4)
  taxAmount            Decimal?  @map("tax_amount") @db.Decimal(20, 4)
  discountAmount       Decimal?  @map("discount_amount") @db.Decimal(20, 4)
  lineItemsCount       Int?      @default(0) @map("line_items_count")
  lineItems            Json      @default("[]") @map("line_items")
  abandonedCheckoutUrl String?   @map("abandoned_checkout_url") @db.Text
  completedOrderId     String?   @map("completed_order_id") @db.VarChar(255)
  startedAt            DateTime  @map("started_at")
  lastActivityAt       DateTime? @map("last_activity_at")
  completedAt          DateTime? @map("completed_at")
  metadata             Json      @default("{}")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @map("updated_at")

  @@unique([siteId, sourceSystem, checkoutId], map: "uq_checkout_source_ref")
  @@index([siteId], map: "idx_checkout_site")
  @@index([connectorInstanceId], map: "idx_checkout_connector")
  @@index([status], map: "idx_checkout_status")
  @@index([startedAt], map: "idx_checkout_started_ts")
  @@map("canonical_checkouts")
}

model OrderSnapshot {
  id                  Int      @id @default(autoincrement())
  orderInternalId     String   @map("order_internal_id") @db.VarChar(36)
  projectId           String?  @map("project_id") @db.VarChar(255)
  connectorInstanceId String?  @map("connector_instance_id") @db.VarChar(36)
  snapshotTimestamp   DateTime @default(now()) @map("snapshot_timestamp")
  lifecycleState      String   @map("lifecycle_state") @db.VarChar(50)
  totalAmount         Decimal? @map("total_amount") @db.Decimal(20, 4)
  metadata            Json?

  order CanonicalOrder @relation(fields: [orderInternalId], references: [id])

  @@index([orderInternalId], map: "idx_shot_order")
  @@index([projectId, snapshotTimestamp], map: "idx_shot_project_ts")
  @@index([connectorInstanceId], map: "idx_shot_connector")
  @@map("order_snapshots")
}

model OrderEvent {
  id                  String   @id @db.VarChar(36)
  orderInternalId     String   @map("order_internal_id") @db.VarChar(36)
  projectId           String?  @map("project_id") @db.VarChar(255)
  connectorInstanceId String?  @map("connector_instance_id") @db.VarChar(36)
  eventType           String   @map("event_type") @db.VarChar(100)
  timestamp           DateTime
  payload             Json     @default("{}")
  correlationId       String?  @map("correlation_id") @db.VarChar(255)

  order CanonicalOrder @relation(fields: [orderInternalId], references: [id])

  @@index([orderInternalId], map: "idx_order_event_order")
  @@index([projectId, timestamp], map: "idx_order_event_project_ts")
  @@index([connectorInstanceId], map: "idx_order_event_connector")
  @@index([eventType], map: "idx_order_event_type")
  @@map("order_events")
}

model CustomerProfile {
  id                  String   @id @db.VarChar(36)
  siteId              String   @map("site_id") @db.VarChar(255)
  connectorInstanceId String?  @map("connector_instance_id") @db.VarChar(36)
  externalIds         Json     @default("{}") @map("external_ids")
  emailHash           String?  @map("email_hash") @db.VarChar(255)
  emailEncrypted      String?  @map("email_encrypted") @db.Text
  phoneHash           String?  @map("phone_hash") @db.VarChar(255)
  lifecycleState      String   @default("NEW_GUEST") @map("lifecycle_state") @db.VarChar(50)
  identityConfidence  Decimal? @map("identity_confidence")
  firstSeenAt         DateTime @default(now()) @map("first_seen_at")
  lastSeenAt          DateTime @default(now()) @map("last_seen_at")
  totalLtv            Decimal? @map("total_ltv")
  metadata            Json     @default("{}")

  sessions          CustomerSession[]
  events            CustomerEvent[]
  identityLinks     IdentityLink[]
  metrics           CustomerMetrics[]
  behaviorSnapshots CustomerBehaviorSnapshot[]
  campaignMessages  CampaignMessage[]

  // Identity uniqueness for the CDP golden record: within a connector an email
  // hash resolves to exactly ONE profile. emailHash is nullable and Postgres
  // treats NULLs as distinct, so guest profiles (no email yet) never collide.
  @@unique([connectorInstanceId, emailHash], map: "uq_cust_profile_connector_email")
  @@index([siteId], map: "idx_cust_profile_site")
  @@index([connectorInstanceId], map: "idx_cust_profile_connector")
  @@index([emailHash], map: "idx_cust_profile_email")
  // Phone is the primary join key for offline/POS orders (identifier_type
  // 'phone_hash'), so the golden-record fallback lookup needs its own index.
  @@index([connectorInstanceId, phoneHash], map: "idx_cust_profile_phone")
  @@map("customer_profiles")
}

model CustomerSession {
  id                  String    @id @db.VarChar(36)
  customerId          String    @map("customer_id") @db.VarChar(36)
  siteId              String    @map("site_id") @db.VarChar(255)
  connectorInstanceId String?   @map("connector_instance_id") @db.VarChar(36)
  startTime           DateTime  @map("start_time")
  endTime             DateTime? @map("end_time")
  durationSeconds     Int?      @map("duration_seconds")
  device              String?   @db.VarChar(100)
  browser             String?   @db.VarChar(100)
  trafficSource       String?   @map("traffic_source") @db.VarChar(255)
  isConverted         Int?      @default(0) @map("is_converted")
  eventCount          Int?      @default(0) @map("event_count")

  customer CustomerProfile @relation(fields: [customerId], references: [id])
  events   CustomerEvent[]

  @@index([customerId], map: "idx_session_customer")
  @@index([siteId], map: "idx_session_site")
  @@index([connectorInstanceId], map: "idx_session_connector")
  @@map("customer_sessions")
}

model CustomerEvent {
  id                  String   @id @db.VarChar(36)
  customerId          String   @map("customer_id") @db.VarChar(36)
  sessionId           String?  @map("session_id") @db.VarChar(36)
  siteId              String   @map("site_id") @db.VarChar(255)
  connectorInstanceId String?  @map("connector_instance_id") @db.VarChar(36)
  eventName           String   @map("event_name") @db.VarChar(255)
  category            String   @db.VarChar(50)
  timestamp           DateTime
  utmSource           String?  @map("utm_source") @db.VarChar(100)
  utmMedium           String?  @map("utm_medium") @db.VarChar(100)
  utmCampaign         String?  @map("utm_campaign") @db.VarChar(100)
  metadata            Json     @default("{}")

  customer CustomerProfile  @relation(fields: [customerId], references: [id])
  session  CustomerSession? @relation(fields: [sessionId], references: [id])

  @@index([sessionId], map: "idx_cust_event_session")
  @@index([customerId, timestamp], map: "idx_cust_event_cust_ts")
  @@index([connectorInstanceId], map: "idx_cust_event_connector")
  @@map("customer_events")
}

model StorefrontSession {
  id                  String   @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(36)
  connectorInstanceId String   @map("connector_instance_id") @db.VarChar(36)
  sessionId           String   @map("session_id")
  visitorId           String   @map("visitor_id")
  startedAt           DateTime @default(now()) @map("started_at") @db.Timestamptz()
  lastActiveAt        DateTime @default(now()) @map("last_active_at") @db.Timestamptz()
  userAgent           String?  @map("user_agent")
  referrer            String?
  landingPage         String?  @map("landing_page")
  deviceType          String?  @map("device_type")
  // Acquisition attribution (first-touch): classified channel + raw utm signals.
  channel             String?  @db.VarChar(20)
  source              String?
  medium              String?
  campaign            String?
  // Client identification parsed from the user_agent header.
  browser             String?  @db.VarChar(40)
  os                  String?  @db.VarChar(40)
  metadata            Json     @default("{}")

  pageViewCount       Int     @default(0) @map("page_view_count")
  pageUrlsVisited     Json    @default("[]") @map("page_urls_visited")
  funnelStage         String  @default("visit") @map("funnel_stage") @db.VarChar(50)
  funnelStagesReached Json    @default("[\"visit\"]") @map("funnel_stages_reached")
  productViewed       Boolean @default(false) @map("product_viewed")
  productIdsViewed    Json    @default("[]") @map("product_ids_viewed")
  addToCart           Boolean @default(false) @map("add_to_cart")
  checkoutStarted     Boolean @default(false) @map("checkout_started")
  purchaseCompleted   Boolean @default(false) @map("purchase_completed")
  lastPageUrl         String? @map("last_page_url")
  lastPageTitle       String? @map("last_page_title")
  platform            String? @db.VarChar(50)

  // CDP bridge: resolved golden-record id. Nullable — a session starts anonymous
  // and is stitched (and prior sessions back-filled) once identity is known.
  // Soft reference (no FK), consistent with this table's connector-keyed design.
  customerProfileId   String? @map("customer_profile_id") @db.VarChar(36)

  @@unique([connectorInstanceId, sessionId], map: "uq_storefront_session_connector_session")
  @@index([connectorInstanceId, customerProfileId], map: "idx_storefront_session_customer")
  @@index([connectorInstanceId], map: "idx_storefront_session_connector")
  @@index([connectorInstanceId, visitorId], map: "idx_storefront_session_visitor")
  @@index([connectorInstanceId, lastActiveAt], map: "idx_storefront_session_last_active")
  @@index([connectorInstanceId, funnelStage], map: "idx_storefront_session_funnel_stage")
  @@index([connectorInstanceId, platform], map: "idx_storefront_session_platform")
  @@index([connectorInstanceId, channel], map: "idx_storefront_session_channel")
  @@index([connectorInstanceId, funnelStage, startedAt(sort: Desc)], map: "idx_ss_funnel")
  @@index([connectorInstanceId, purchaseCompleted, startedAt(sort: Desc)], map: "idx_ss_purchase")
  @@map("storefront_sessions")
}

model StorefrontEvent {
  id                  String   @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(36)
  connectorInstanceId String   @map("connector_instance_id") @db.VarChar(36)
  sessionId           String   @map("session_id")
  visitorId           String   @map("visitor_id")
  eventType           String   @map("event_type")
  canonicalStage      String?  @map("canonical_stage") @db.VarChar(50)
  pageUrl             String?  @map("page_url")
  pageTitle           String?  @map("page_title")
  occurredAt          DateTime @default(now()) @map("occurred_at") @db.Timestamptz()
  receivedAt          DateTime @default(now()) @map("received_at") @db.Timestamptz()
  properties          Json     @default("{}")

  // CDP bridge: resolved golden-record id (nullable; back-filled on stitch).
  customerProfileId   String?  @map("customer_profile_id") @db.VarChar(36)

  @@index([connectorInstanceId], map: "idx_storefront_event_connector")
  @@index([connectorInstanceId, customerProfileId], map: "idx_storefront_event_customer")
  @@index([connectorInstanceId, occurredAt], map: "idx_storefront_event_connector_occurred")
  @@index([connectorInstanceId, sessionId], map: "idx_storefront_event_session")
  @@index([connectorInstanceId, eventType, occurredAt], map: "idx_storefront_event_type_occurred")
  @@index([connectorInstanceId, canonicalStage, occurredAt], map: "idx_storefront_events_canonical_stage")
  @@map("storefront_events")
}

model StorefrontError {
  id                  String   @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(36)
  projectId           String   @map("project_id") @db.VarChar(255)
  connectorInstanceId String?  @map("connector_instance_id") @db.VarChar(36)
  errorType           String   @map("error_type") @db.VarChar(50)
  severity            String   @db.VarChar(20)
  message             String   @db.Text
  sourceUrl           String?  @map("source_url") @db.Text
  stackTrace          String?  @map("stack_trace") @db.Text
  requestUrl          String?  @map("request_url") @db.Text
  statusCode          Int?     @map("status_code")
  httpMethod          String?  @map("http_method") @db.VarChar(10)
  durationMs          Int?     @map("duration_ms")
  resourceTag         String?  @map("resource_tag") @db.VarChar(20)
  pageType            String?  @map("page_type") @db.VarChar(30)
  pageUrl             String?  @map("page_url") @db.Text
  userAgent           String?  @map("user_agent") @db.Text
  sessionId           String?  @map("session_id") @db.VarChar(100)
  metadata            Json     @default("{}")
  occurredAt          DateTime @map("occurred_at") @db.Timestamptz()
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([projectId, occurredAt(sort: Desc)], map: "idx_storefront_error_project_occurred")
  @@index([connectorInstanceId, occurredAt(sort: Desc)], map: "idx_storefront_error_connector_occurred")
  @@index([projectId, errorType, occurredAt], map: "idx_storefront_error_type")
  @@index([projectId, pageType, occurredAt], map: "idx_storefront_error_page")
  @@map("storefront_errors")
}

model PerformanceMetric {
  id                  Int      @id @default(autoincrement())
  siteId              String   @map("site_id") @db.VarChar(255)
  connectorInstanceId String?  @map("connector_instance_id") @db.VarChar(36)
  category            String   @db.VarChar(50)
  metricName          String   @map("metric_name") @db.VarChar(100)
  source              String   @default("unknown") @db.VarChar(100)
  metricValue         Decimal  @map("metric_value") @db.Decimal(20, 4)
  unit                String   @db.VarChar(20)
  region              String?  @db.VarChar(100)
  device              String?  @db.VarChar(100)
  browser             String?  @db.VarChar(100)
  route               String?  @db.VarChar(1024)
  timestamp           DateTime
  traceId             String?  @map("trace_id") @db.VarChar(255)
  correlationId       String?  @map("correlation_id") @db.VarChar(255)

  @@unique([siteId, metricName, source], map: "uq_perf_site_metric_source")
  @@index([siteId, metricName, timestamp], map: "idx_perf_site_name_ts")
  @@index([connectorInstanceId, timestamp], map: "idx_perf_connector_ts")
  @@map("performance_metrics")
}

model PerformanceRollup {
  id                  Int      @id @default(autoincrement())
  siteId              String   @map("site_id") @db.VarChar(255)
  connectorInstanceId String?  @map("connector_instance_id") @db.VarChar(36)
  metricName          String   @map("metric_name") @db.VarChar(100)
  bucketSize          String   @map("bucket_size") @db.VarChar(20)
  timestamp           DateTime
  count               Int
  min                 Decimal? @db.Decimal(20, 4)
  max                 Decimal? @db.Decimal(20, 4)
  sum                 Decimal? @db.Decimal(20, 4)
  avg                 Decimal? @db.Decimal(20, 4)
  p50                 Decimal? @db.Decimal(20, 4)
  p90                 Decimal? @db.Decimal(20, 4)
  p99                 Decimal? @db.Decimal(20, 4)
  dimensions          Json     @default("{}")

  @@index([siteId, metricName, bucketSize, timestamp], map: "idx_perf_rollup")
  @@index([connectorInstanceId, timestamp], map: "idx_perf_rollup_connector_ts")
  @@map("performance_rollups")
}

model KpiValue {
  id                  Int      @id @default(autoincrement())
  siteId              String   @map("site_id") @db.VarChar(255)
  connectorInstanceId String?  @map("connector_instance_id") @db.VarChar(36)
  kpiName             String   @map("kpi_name") @db.VarChar(100)
  kpiValue            Decimal  @map("kpi_value") @db.Decimal(20, 4)
  timeWindow          String   @map("time_window") @db.VarChar(20)
  timestamp           DateTime
  metadata            Json     @default("{}")
  updatedAt           DateTime @default(now()) @map("updated_at")

  @@index([siteId, kpiName, timestamp], map: "idx_kpi_site_name_ts")
  @@index([connectorInstanceId, timestamp], map: "idx_kpi_connector_ts")
  @@map("kpi_values")
}

model DiscoveredPageUrl {
  id                  String   @id @default(uuid()) @db.VarChar(36)
  connectorInstanceId String   @map("connector_instance_id") @db.VarChar(36)
  siteId              String   @map("site_id") @db.VarChar(255)
  pageType            String   @map("page_type") @db.VarChar(20)
  resolvedUrl         String   @map("resolved_url") @db.VarChar(1024)
  urlResolutionMethod String   @map("url_resolution_method") @db.VarChar(20)
  rank                Int      @default(0)
  discoveredAt        DateTime @default(now()) @map("discovered_at")
  createdAt           DateTime @default(now()) @map("created_at")

  @@unique([connectorInstanceId, pageType, resolvedUrl], map: "uq_discovered_page_url")
  @@index([connectorInstanceId, pageType], map: "idx_discovered_connector_pagetype")
  @@map("discovered_page_urls")
}

model Alert {
  id                  String    @id @db.VarChar(36)
  siteId              String    @map("site_id") @db.VarChar(255)
  connectorInstanceId String?   @map("connector_instance_id") @db.VarChar(36)
  severity            String    @db.VarChar(20)
  status              String    @default("TRIGGERED") @db.VarChar(50)
  module              String    @db.VarChar(50)
  alertType           String    @map("alert_type") @db.VarChar(100)
  message             String    @db.Text
  context             Json      @default("{}")
  correlationId       String?   @map("correlation_id") @db.VarChar(255)
  triggeredAt         DateTime  @default(now()) @map("triggered_at")
  acknowledgedAt      DateTime? @map("acknowledged_at")
  acknowledgedBy      String?   @map("acknowledged_by") @db.VarChar(255)
  resolvedAt          DateTime? @map("resolved_at")

  @@index([siteId], map: "idx_alert_site")
  @@index([connectorInstanceId], map: "idx_alert_connector")
  @@index([status], map: "idx_alert_status")
  @@map("alerts")
}

model AlertRule {
  id                  String   @id @db.VarChar(36)
  siteId              String   @map("site_id") @db.VarChar(255)
  connectorInstanceId String?  @map("connector_instance_id") @db.VarChar(36)
  name                String   @db.VarChar(255)
  description         String?  @db.Text
  severity            String   @db.VarChar(20)
  enabled             Int?     @default(1)
  criteria            Json
  cooldownMinutes     Int?     @default(60) @map("cooldown_minutes")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @map("updated_at")

  @@index([siteId], map: "idx_alert_rule_site")
  @@index([connectorInstanceId], map: "idx_alert_rule_connector")
  @@map("alert_rules")
}

// ─────────────────────────────────────────────────────────────────────────────
// CDP IDENTITY RESOLUTION (Phase 1 — see docs/CDP-IMPLEMENTATION-PLAN.md §4)
//
// identity_links is the identity graph: an append-updated edge log mapping every
// observed identifier (visitor_id, session_id, email_hash, external_id) to the
// single CustomerProfile (golden record) it belongs to. The unique constraint on
// (connector_instance_id, identifier_type, identifier_value) is the core CDP
// invariant: one identifier maps to exactly one profile at a time — this is what
// prevents duplicate golden records under concurrent ingest.
// ─────────────────────────────────────────────────────────────────────────────
model IdentityLink {
  id                  String   @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(36)
  siteId              String   @map("site_id") @db.VarChar(255)
  connectorInstanceId String   @map("connector_instance_id") @db.VarChar(36)
  customerProfileId   String   @map("customer_profile_id") @db.VarChar(36)
  // visitor_id | session_id | email_hash | external_id
  identifierType      String   @map("identifier_type") @db.VarChar(20)
  identifierValue     String   @map("identifier_value") @db.VarChar(255)
  // 1.0 = deterministic (email/external id); <1.0 = probabilistic (visitor stitch).
  confidence          Decimal  @default(1.0) @db.Decimal(4, 3)
  firstSeenAt         DateTime @default(now()) @map("first_seen_at") @db.Timestamptz()
  lastSeenAt          DateTime @default(now()) @map("last_seen_at") @db.Timestamptz()

  customer CustomerProfile @relation(fields: [customerProfileId], references: [id])

  @@unique([connectorInstanceId, identifierType, identifierValue], map: "uq_identity_link_identifier")
  @@index([customerProfileId], map: "idx_identity_link_customer")
  @@map("identity_links")
}

// ─────────────────────────────────────────────────────────────────────────────
// CDP CUSTOMER ANALYTICS (Phase 2 — see docs/CDP-IMPLEMENTATION-PLAN.md §5.1)
//
// One current row per customer profile holding the computed transactional
// intelligence (RFM / CLTV / churn / segment) derived from canonical_orders by
// CustomerAnalyticsService. This is the "history" half of the golden record that
// the CDP fuses with live behavior. Recompute upserts on the unique key.
// ─────────────────────────────────────────────────────────────────────────────
model CustomerMetrics {
  id                  String   @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(36)
  customerProfileId   String   @map("customer_profile_id") @db.VarChar(36)
  siteId              String   @map("site_id") @db.VarChar(255)
  connectorInstanceId String   @map("connector_instance_id") @db.VarChar(36)

  orderCount       Int       @default(0) @map("order_count")
  totalRevenue     Decimal   @default(0) @map("total_revenue")
  avgOrderValue    Decimal   @default(0) @map("avg_order_value")
  firstOrderAt     DateTime? @map("first_order_at") @db.Timestamptz()
  lastOrderAt      DateTime? @map("last_order_at") @db.Timestamptz()
  recencyDays      Int?      @map("recency_days")
  frequencyMonthly Decimal?  @map("frequency_monthly")

  // RFM (1-5 scores from population quantiles) + combined.
  rfmRecency  Int? @map("rfm_recency")
  rfmFreq     Int? @map("rfm_frequency")
  rfmMonetary Int? @map("rfm_monetary")
  rfmScore    Int? @map("rfm_score")

  cltv     Decimal? // projected lifetime value
  cltvTier String?  @map("cltv_tier") @db.VarChar(20)

  churnRisk  Decimal? @map("churn_risk") @db.Decimal(4, 3) // 0-1
  churnLevel String?  @map("churn_level") @db.VarChar(20)  // low|medium|high|critical

  segment String? @db.VarChar(30) // VIP|HIGH_VALUE|AT_RISK|LOST|REGULAR

  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz()

  customer CustomerProfile @relation(fields: [customerProfileId], references: [id])

  @@unique([connectorInstanceId, customerProfileId], map: "uq_customer_metrics_profile")
  @@index([connectorInstanceId, segment], map: "idx_customer_metrics_segment")
  @@index([connectorInstanceId, churnLevel], map: "idx_customer_metrics_churn")
  @@map("customer_metrics")
}

// ─────────────────────────────────────────────────────────────────────────────
// CDP BEHAVIORAL FUSION (Phase 3 — see docs/CDP-IMPLEMENTATION-PLAN.md §5.2/§6.1)
//
// One current row per profile holding LIVE behavioral signals (from storefront
// sessions/events) fused with historical metrics into "fused segments" that need
// both — e.g. HIGH_VALUE_ABANDONER (VIP + live cart abandon). Refreshed by
// BehavioralFusionService. fusedSegments is a JSON string[] (queried with
// array_contains) so the customer list + Phase 4 triggers can target it.
// ─────────────────────────────────────────────────────────────────────────────
model CustomerBehaviorSnapshot {
  id                  String   @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(36)
  customerProfileId   String   @map("customer_profile_id") @db.VarChar(36)
  siteId              String   @map("site_id") @db.VarChar(255)
  connectorInstanceId String   @map("connector_instance_id") @db.VarChar(36)

  lastSessionAt    DateTime? @map("last_session_at") @db.Timestamptz()
  sessionsLast30d  Int       @default(0) @map("sessions_last_30d")
  liveFurthestStage String?  @map("live_furthest_stage") @db.VarChar(50)
  cartAbandonedAt  DateTime? @map("cart_abandoned_at") @db.Timestamptz()

  recentCategories Json @default("[]") @map("recent_categories")
  fusedSegments    Json @default("[]") @map("fused_segments")
  signals          Json @default("{}")

  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz()

  customer CustomerProfile @relation(fields: [customerProfileId], references: [id])

  @@unique([connectorInstanceId, customerProfileId], map: "uq_behavior_snapshot_profile")
  @@index([connectorInstanceId], map: "idx_behavior_snapshot_connector")
  @@map("customer_behavior_snapshots")
}

// ─────────────────────────────────────────────────────────────────────────────
// CDP TRIGGERED CAMPAIGNS (Phase 4 — see docs/CDP-IMPLEMENTATION-PLAN.md §6.2)
//
// A personalized message generated for a customer because a fused segment (Phase 3)
// matched — combining their history + recommendations + live signal. Persisted as a
// draft (status GENERATED) for approval, then SENT via EmailService. The
// (connector, customer, trigger) recency acts as the cooldown key.
// ─────────────────────────────────────────────────────────────────────────────
model CampaignMessage {
  id                  String @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(36)
  customerProfileId   String @map("customer_profile_id") @db.VarChar(36)
  siteId              String @map("site_id") @db.VarChar(255)
  connectorInstanceId String @map("connector_instance_id") @db.VarChar(36)

  trigger  String  @db.VarChar(80)  // fused segment name, or "group:<uuid>" for group campaigns
  goal     String  @db.VarChar(40)  // cart_recovery | win_back | welcome_offer | vip_appreciation
  channel  String  @default("email") @db.VarChar(20)
  subject  String  @db.Text
  body     String  @db.Text
  recommendedProducts Json @default("[]") @map("recommended_products")
  generator String @db.VarChar(20)  // claude | template

  status  String  @default("GENERATED") @db.VarChar(20) // GENERATED | SENT | FAILED | SKIPPED
  reason  String? @db.Text
  sentAt  DateTime? @map("sent_at") @db.Timestamptz()
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  customer CustomerProfile @relation(fields: [customerProfileId], references: [id])

  @@index([connectorInstanceId, customerProfileId], map: "idx_campaign_msg_customer")
  @@index([connectorInstanceId, status], map: "idx_campaign_msg_status")
  @@index([connectorInstanceId, customerProfileId, trigger], map: "idx_campaign_msg_cooldown")
  @@map("campaign_messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// CDP CUSTOMER GROUPS (Phase 5 — user-defined dynamic segments)
//
// A user-created, RULE-BASED customer group ("Big Spenders", "Win-back targets").
// `rules` holds a match mode + condition list evaluated by CustomerGroupService
// over customer_metrics + behavior snapshots; membership is DYNAMIC (recomputed on
// read), so there is no membership table. Groups are campaign-targetable.
// ─────────────────────────────────────────────────────────────────────────────
model CustomerGroup {
  id                  String @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(36)
  connectorInstanceId String @map("connector_instance_id") @db.VarChar(36)
  siteId              String @map("site_id") @db.VarChar(255)

  name        String  @db.VarChar(120)
  description String? @db.Text
  color       String? @db.VarChar(20)
  // { match: 'all' | 'any', conditions: [{ field, op, value }] } — see CustomerGroupService.
  rules       Json    @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([connectorInstanceId, name], map: "uq_customer_group_name")
  @@index([connectorInstanceId], map: "idx_customer_group_connector")
  @@map("customer_groups")
}

// ─────────────────────────────────────────────────────────────────────────────
// CDP CAMPAIGN RUN JOBS (Phase 5 — async group campaign generation)
//
// Tracks a background run that generates drafts for a set of customers (e.g. all
// members of a group). The API returns a job id immediately and generates in the
// background, updating progress here; the UI polls this row until COMPLETED.
// ─────────────────────────────────────────────────────────────────────────────
model CampaignRunJob {
  id                  String @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(36)
  connectorInstanceId String @map("connector_instance_id") @db.VarChar(36)
  siteId              String @map("site_id") @db.VarChar(255)

  kind    String  @db.VarChar(20) // 'group'
  groupId String? @map("group_id") @db.VarChar(36)
  goal    String  @db.VarChar(40)
  label   String? @db.VarChar(160) // display label (e.g. group name)

  status    String  @default("RUNNING") @db.VarChar(20) // RUNNING | COMPLETED | FAILED
  total     Int     @default(0)
  processed Int     @default(0)
  generated Int     @default(0)
  skipped   Int     @default(0)
  error     String? @db.Text

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  finishedAt DateTime? @map("finished_at") @db.Timestamptz()

  @@index([connectorInstanceId, status], map: "idx_campaign_job_status")
  @@index([connectorInstanceId, groupId], map: "idx_campaign_job_group")
  @@map("campaign_run_jobs")
}

// Audit + reversibility for profile merges (when two profiles are found to be the
// same person). Keeps the pre-merge snapshot so a mistaken merge can be undone.
model ProfileMerge {
  id                  String   @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(36)
  connectorInstanceId String   @map("connector_instance_id") @db.VarChar(36)
  fromProfileId       String   @map("from_profile_id") @db.VarChar(36)
  intoProfileId       String   @map("into_profile_id") @db.VarChar(36)
  reason              String?  @db.VarChar(255)
  payload             Json     @default("{}")
  mergedAt            DateTime @default(now()) @map("merged_at") @db.Timestamptz()

  @@index([intoProfileId], map: "idx_profile_merge_into")
  @@index([fromProfileId], map: "idx_profile_merge_from")
  @@map("profile_merges")
}

  cursorType    String   @map("cursor_type") @db.VarChar(50)
  cursorValue   String   @map("cursor_value") @db.VarChar(255)
  metadata      Json     @default("{}")
  updatedAt     DateTime @default(now()) @map("updated_at")

  project     Project           @relation(fields: [siteId], references: [id])
  integration ConnectorInstance @relation(fields: [integrationId], references: [id])

  @@index([integrationId, entityType], map: "idx_pipe_ckpt_integration_entity")
  @@map("pipeline_checkpoints")
}

model DeadLetterQueue {
  id              String   @id @db.VarChar(36)
  jobId           String   @map("job_id") @db.VarChar(36)
  siteId          String   @map("site_id") @db.VarChar(255)
  tenantId        String   @map("tenant_id") @db.VarChar(36)
  failureCategory String   @map("failure_category") @db.VarChar(50)
  reason          String   @db.Text
  payloadSnapshot Json?    @map("payload_snapshot")
  reviewedBy      String?  @map("reviewed_by") @db.VarChar(255)
  actionTaken     String?  @map("action_taken") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @map("updated_at")

  job     PipelineJob @relation(fields: [jobId], references: [id])
  project Project     @relation(fields: [siteId], references: [id])
  tenant  Tenant      @relation(fields: [tenantId], references: [id])

  @@index([siteId, actionTaken], map: "idx_dlq_site_status")
  @@map("dead_letter_queue")
}

model RecoveryJob {
  id               String    @id @db.VarChar(36)
  siteId           String    @map("site_id") @db.VarChar(255)
  tenantId         String    @map("tenant_id") @db.VarChar(36)
  jobType          String    @map("job_type") @db.VarChar(50)
  status           String    @default("PENDING") @db.VarChar(50)
  scope            Json
  config           Json      @default("{}")
  totalRecords     Int?      @default(0) @map("total_records")
  processedRecords Int?      @default(0) @map("processed_records")
  failedRecords    Int?      @default(0) @map("failed_records")
  triggeredBy      String    @map("triggered_by") @db.VarChar(255)
  reason           String?   @db.Text
  startedAt        DateTime  @default(now()) @map("started_at")
  updatedAt        DateTime  @default(now()) @map("updated_at")
  finishedAt       DateTime? @map("finished_at")
  lastError        Json?     @map("last_error")

  project Project @relation(fields: [siteId], references: [id])
  tenant  Tenant  @relation(fields: [tenantId], references: [id])

  @@index([siteId, status], map: "idx_recovery_site_status")
  @@map("recovery_jobs")
}

model StorefrontSession {
  id                  String   @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(36)
  connectorInstanceId String   @map("connector_instance_id") @db.VarChar(36)
  tenantId            String   @map("tenant_id") @db.VarChar(36)
  sessionId           String   @map("session_id")
  visitorId           String   @map("visitor_id")
  startedAt           DateTime @default(now()) @map("started_at") @db.Timestamptz()
  lastActiveAt        DateTime @default(now()) @map("last_active_at") @db.Timestamptz()
  userAgent           String?  @map("user_agent")
  referrer            String?
  landingPage         String?  @map("landing_page")
  deviceType          String?  @map("device_type")
  metadata            Json     @default("{}")

  // ── Funnel aggregate (collapsed page-view spam; authoritative funnel record) ──
  pageViewCount       Int     @default(0) @map("page_view_count")
  pageUrlsVisited     Json    @default("[]") @map("page_urls_visited")
  funnelStage         String  @default("visit") @map("funnel_stage") @db.VarChar(50)
  funnelStagesReached Json    @default("[\"visit\"]") @map("funnel_stages_reached")
  productViewed       Boolean @default(false) @map("product_viewed")
  productIdsViewed    Json    @default("[]") @map("product_ids_viewed")
  addToCart           Boolean @default(false) @map("add_to_cart")
  checkoutStarted     Boolean @default(false) @map("checkout_started")
  purchaseCompleted   Boolean @default(false) @map("purchase_completed")
  lastPageUrl         String? @map("last_page_url")
  lastPageTitle       String? @map("last_page_title")
  platform            String? @db.VarChar(50)

  connectorInstance ConnectorInstance @relation(fields: [connectorInstanceId], references: [id], onDelete: Cascade)

  @@unique([connectorInstanceId, sessionId], map: "uq_storefront_session_connector_session")
  @@index([tenantId], map: "idx_storefront_session_tenant")
  @@index([connectorInstanceId], map: "idx_storefront_session_connector")
  @@index([connectorInstanceId, visitorId], map: "idx_storefront_session_visitor")
  @@index([connectorInstanceId, lastActiveAt], map: "idx_storefront_session_last_active")
  @@index([connectorInstanceId, funnelStage], map: "idx_storefront_session_funnel_stage")
  @@index([connectorInstanceId, platform], map: "idx_storefront_session_platform")
  @@index([connectorInstanceId, funnelStage, startedAt(sort: Desc)], map: "idx_ss_funnel")
  @@index([connectorInstanceId, purchaseCompleted, startedAt(sort: Desc)], map: "idx_ss_purchase")
  @@map("storefront_sessions")
}

model StorefrontEvent {
  id                  String   @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(36)
  connectorInstanceId String   @map("connector_instance_id") @db.VarChar(36)
  tenantId            String   @map("tenant_id") @db.VarChar(36)
  sessionId           String   @map("session_id")
  visitorId           String   @map("visitor_id")
  eventType           String   @map("event_type")
  canonicalStage      String?  @map("canonical_stage") @db.VarChar(50)
  pageUrl             String?  @map("page_url")
  pageTitle           String?  @map("page_title")
  occurredAt          DateTime @default(now()) @map("occurred_at") @db.Timestamptz()
  receivedAt          DateTime @default(now()) @map("received_at") @db.Timestamptz()
  properties          Json     @default("{}")

  connectorInstance ConnectorInstance @relation(fields: [connectorInstanceId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "idx_storefront_event_tenant")
  @@index([connectorInstanceId], map: "idx_storefront_event_connector")
  @@index([connectorInstanceId, occurredAt], map: "idx_storefront_event_connector_occurred")
  @@index([connectorInstanceId, sessionId], map: "idx_storefront_event_session")
  @@index([connectorInstanceId, eventType, occurredAt], map: "idx_storefront_event_type_occurred")
  @@index([connectorInstanceId, canonicalStage, occurredAt], map: "idx_storefront_events_canonical_stage")
  @@map("storefront_events")
}

// Storefront RUM errors & issues captured by the public tracker script
// (js_error, promise_rejection, network_error, resource_error, checkout_error,
// console_error). Scoped by project_id; the connector is best-effort (nullable,
// SET NULL on delete) since a storefront page only carries connector_instance_id.
// `metadata` holds the per-type flags (platform pattern hits, payment/cart/
// checkout severity, slow/failed booleans, js line/column) that have no column.
model StorefrontError {
  id                  String   @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(36)
  projectId           String   @map("project_id") @db.VarChar(255)
  connectorInstanceId String?  @map("connector_instance_id") @db.VarChar(36)
  errorType           String   @map("error_type") @db.VarChar(50)
  severity            String   @db.VarChar(20)
  message             String   @db.Text
  sourceUrl           String?  @map("source_url") @db.Text
  stackTrace          String?  @map("stack_trace") @db.Text
  requestUrl          String?  @map("request_url") @db.Text
  statusCode          Int?     @map("status_code")
  httpMethod          String?  @map("http_method") @db.VarChar(10)
  durationMs          Int?     @map("duration_ms")
  resourceTag         String?  @map("resource_tag") @db.VarChar(20)
  pageType            String?  @map("page_type") @db.VarChar(30)
  pageUrl             String?  @map("page_url") @db.Text
  userAgent           String?  @map("user_agent") @db.Text
  sessionId           String?  @map("session_id") @db.VarChar(100)
  metadata            Json     @default("{}")
  occurredAt          DateTime @map("occurred_at") @db.Timestamptz()
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connectorInstance ConnectorInstance? @relation(fields: [connectorInstanceId], references: [id], onDelete: SetNull)

  @@index([projectId, occurredAt(sort: Desc)], map: "idx_storefront_error_project_occurred")
  @@index([connectorInstanceId, occurredAt(sort: Desc)], map: "idx_storefront_error_connector_occurred")
  @@index([projectId, errorType, occurredAt], map: "idx_storefront_error_type")
  @@index([projectId, pageType, occurredAt], map: "idx_storefront_error_page")
  @@map("storefront_errors")
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

model Tenant {
  id        String   @id @db.VarChar(36)
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(255)
  status    String   @default("ACTIVE") @db.VarChar(50)
  plan      String   @default("FREE") @db.VarChar(50)
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  projects                      Project[]
  users                         User[]
  auditLogs                     IamAuditLog[]
  customerProfiles              CustomerProfile[]
  identityLinks                 IdentityLink[]
  connectorInstances            ConnectorInstance[]
  connectorResyncJobs           ConnectorResyncJob[]
  projectAccessKeys             ProjectAccessKey[]
  webhookSubscriptions          WebhookSubscription[]
  connectorCredentials          ConnectorCredential[]
  connectorLifecycleEvents      ConnectorLifecycleEvent[]
  paymentGatewayConfigs         PaymentGatewayConfig[]
  paymentGatewayStatusSnapshots PaymentGatewayStatusSnapshot[]
  alerts                        Alert[]
  alertRules                    AlertRule[]
  systemLogs                    SystemLog[]
  performanceMetrics            PerformanceMetric[]
  kpiValues                     KpiValue[]
  canonicalOrders               CanonicalOrder[]
  ingestionEvents               IngestionEvent[]
  pipelineJobs                  PipelineJob[]
  deadLetterQueues              DeadLetterQueue[]
  recoveryJobs                  RecoveryJob[]
  canonicalProducts             CanonicalProduct[]
  canonicalCheckouts            CanonicalCheckout[]

  @@map("tenants")
}

model Project {
  id              String   @id @db.VarChar(255)
  tenantId        String   @map("tenant_id") @db.VarChar(36)
  name            String   @db.VarChar(255)
  slug            String?  @db.VarChar(255)
  environment     String   @default("production") @db.VarChar(50)
  status          String   @default("ACTIVE") @db.VarChar(50)
  activeVersionId String?  @map("active_version_id") @db.VarChar(36)
  settings        Json     @default("{}")
  createdBy       String?  @db.VarChar(36)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @map("updated_at")

  tenant                        Tenant                         @relation(fields: [tenantId], references: [id])
  configVersions                ConfigVersion[]
  userAccess                    UserProjectAccess[]
  customerProfiles              CustomerProfile[]
  customerSessions              CustomerSession[]
  customerEvents                CustomerEvent[]
  connectorInstances            ConnectorInstance[]
  connectorResyncJobs           ConnectorResyncJob[]
  connectorCredentials          ConnectorCredential[]
  projectAccessKeys             ProjectAccessKey[]
  webhookSubscriptions          WebhookSubscription[]
  connectorLifecycleEvents      ConnectorLifecycleEvent[]
  alerts                        Alert[]
  alertRules                    AlertRule[]
  systemLogs                    SystemLog[]
  iamAuditLogs                  IamAuditLog[]
  systemHealthMetrics           SystemHealthMetric[]
  connectorHealthSnapshots      ConnectorHealthSnapshot[]
  performanceMetrics            PerformanceMetric[]
  performanceRollups            PerformanceRollup[]
  kpiValues                     KpiValue[]
  canonicalOrders               CanonicalOrder[]
  orderSnapshots                OrderSnapshot[]
  orderEvents                   OrderEvent[]
  ingestionEvents               IngestionEvent[]
  pipelineJobs                  PipelineJob[]
  pipelineCheckpoints           PipelineCheckpoint[]
  deadLetterQueues              DeadLetterQueue[]
  recoveryJobs                  RecoveryJob[]
  canonicalProducts             CanonicalProduct[]
  canonicalCheckouts            CanonicalCheckout[]
  paymentGatewayConfigs         PaymentGatewayConfig[]
  paymentGatewayStatusSnapshots PaymentGatewayStatusSnapshot[]
  userPagePermissions           UserPagePermission[]
  storefrontErrors              StorefrontError[]

  @@index([tenantId], map: "idx_project_tenant")
  @@map("projects")
}

model PaymentGatewayConfig {
  id            String    @id @db.VarChar(36)
  projectId     String    @map("project_id") @db.VarChar(255)
  tenantId      String    @map("tenant_id") @db.VarChar(36)
  gatewayName   String    @map("gateway_name") @db.VarChar(50)
  label         String    @db.VarChar(255)
  apiKey        String?   @map("api_key") @db.VarChar(255)
  apiSecret     String?   @map("api_secret") @db.VarChar(255)
  isActive      Boolean   @default(true) @map("is_active")
  lastCheckedAt DateTime? @map("last_checked_at")
  lastStatus    String?   @map("last_status") @db.VarChar(20)
  lastPayload   Json?     @map("last_payload")
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @map("updated_at")

  project   Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant    Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  snapshots PaymentGatewayStatusSnapshot[]

  @@unique([projectId, tenantId, gatewayName], map: "uq_payment_gateway_project_gateway")
  @@index([projectId], map: "idx_payment_gateway_project")
  @@index([tenantId], map: "idx_payment_gateway_tenant")
  @@index([gatewayName], map: "idx_payment_gateway_name")
  @@map("payment_gateway_configs")
}

model PaymentGatewayStatusSnapshot {
  id                     String   @id @db.VarChar(36)
  paymentGatewayConfigId String   @map("payment_gateway_config_id") @db.VarChar(36)
  projectId              String   @map("project_id") @db.VarChar(255)
  tenantId               String   @map("tenant_id") @db.VarChar(36)
  gatewayName            String   @map("gateway_name") @db.VarChar(50)
  status                 String   @db.VarChar(20)
  activeDowntimes        Json     @default("[]") @map("active_downtimes")
  payload                Json     @default("{}")
  checkedAt              DateTime @default(now()) @map("checked_at")
  source                 String   @default("journey-refresh") @db.VarChar(50)
  errorMessage           String?  @map("error_message") @db.Text

  paymentGatewayConfig PaymentGatewayConfig @relation(fields: [paymentGatewayConfigId], references: [id], onDelete: Cascade)
  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([projectId, gatewayName, checkedAt], map: "idx_payment_gateway_snapshot_project_ts")
  @@index([paymentGatewayConfigId, checkedAt], map: "idx_payment_gateway_snapshot_config_ts")
  @@map("payment_gateway_status_snapshots")
}

model User {
  id           String    @id @db.VarChar(36)
  tenantId     String    @map("tenant_id") @db.VarChar(36)
  email        String    @unique @db.VarChar(255)
  name         String    @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         String    @db.VarChar(50)
  status       String    @default("ACTIVE") @db.VarChar(50)
  mfaEnabled   Int?      @default(0) @map("mfa_enabled")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @map("updated_at")

  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  projectAccess   UserProjectAccess[]
  pagePermissions UserPagePermission[]
  sessions        UserSession[]
  otpCodes        OtpCode[]

  @@index([tenantId], map: "idx_user_tenant")
  @@map("users")
}

model UserSession {
  token     String   @id @db.VarChar(255)
  userId    String   @map("user_id") @db.VarChar(36)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  metadata  Json     @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_session_user")
  @@index([expiresAt], map: "idx_session_expires")
  @@map("user_sessions")
}

model OtpCode {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.VarChar(36)
  email        String    @db.VarChar(255)
  codeHash     String    @map("code_hash") @db.VarChar(255)
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")
  attemptCount Int       @default(0) @map("attempt_count")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_otp_user")
  @@index([email], map: "idx_otp_email")
  @@index([expiresAt], map: "idx_otp_expires")
  @@map("otp_codes")
}

model UserProjectAccess {
  userId       String   @map("user_id") @db.VarChar(36)
  projectId    String   @map("project_id") @db.VarChar(255)
  roleOverride String?  @map("role_override") @db.VarChar(50)
  assignedAt   DateTime @default(now()) @map("assigned_at")

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@id([userId, projectId])
  @@map("user_project_access")
}

model UserPagePermission {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.VarChar(36)
  projectId String   @map("project_id") @db.VarChar(255)
  pageKey   String   @map("page_key") @db.VarChar(100)
  isAllowed Boolean  @default(true) @map("is_allowed")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, pageKey], map: "uq_user_page_permission")
  @@index([userId, projectId], map: "idx_user_page_permission_user_project")
  @@index([projectId, pageKey], map: "idx_user_page_permission_project_page")
  @@map("user_page_permissions")
}

model ConfigVersion {
  versionId               String   @id @map("version_id") @db.VarChar(36)
  siteId                  String   @map("site_id") @db.VarChar(255)
  versionNumber           Int      @map("version_number")
  status                  String   @db.VarChar(50)
  kpiDefinitionBlob       Json     @default("{}") @map("kpi_definition_blob")
  widgetDefinitionBlob    Json     @default("{}") @map("widget_definition_blob")
  connectorDefinitionBlob Json     @default("{}") @map("connector_definition_blob")
  createdBy               String   @map("created_by") @db.VarChar(255)
  createdAt               DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [siteId], references: [id])

  @@map("config_versions")
}

model IamAuditLog {
  id                  Int      @id @default(autoincrement())
  tenantId            String   @map("tenant_id") @db.VarChar(36)
  projectId           String?  @map("project_id") @db.VarChar(255)
  connectorInstanceId String?  @map("connector_instance_id") @db.VarChar(36)
  actorId             String   @map("actor_id") @db.VarChar(255)
  action              String   @db.VarChar(255)
  targetType          String   @map("target_type") @db.VarChar(255)
  targetId            String   @map("target_id") @db.VarChar(255)
  metadata            Json     @default("{}")
  timestamp           DateTime @default(now())

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  project           Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  connectorInstance ConnectorInstance? @relation(fields: [connectorInstanceId], references: [id], onDelete: SetNull)

  @@index([tenantId, timestamp], map: "idx_iam_audit_tenant_ts")
  @@index([projectId, timestamp], map: "idx_iam_audit_project_ts")
  @@index([connectorInstanceId], map: "idx_iam_audit_connector")
  @@map("iam_audit_logs")
}

model CustomerProfile {
  id                  String   @id @db.VarChar(36)
  siteId              String   @map("site_id") @db.VarChar(255)
  tenantId            String   @map("tenant_id") @db.VarChar(36)
  connectorInstanceId String?  @map("connector_instance_id") @db.VarChar(36)
  externalIds         Json     @default("{}") @map("external_ids")
  emailHash           String?  @map("email_hash") @db.VarChar(255)
  // Reversible AES-256-GCM envelope of the email (enc:v1:...). The ONLY recoverable
  // copy of the address — decrypted on the read path to display on the dashboard.
  emailEncrypted      String?  @map("email_encrypted") @db.Text
  phoneHash           String?  @map("phone_hash") @db.VarChar(255)
  lifecycleState      String   @default("NEW_GUEST") @map("lifecycle_state") @db.VarChar(50)
  identityConfidence  Decimal? @map("identity_confidence")
  firstSeenAt         DateTime @default(now()) @map("first_seen_at")
  lastSeenAt          DateTime @default(now()) @map("last_seen_at")
  totalLtv            Decimal? @map("total_ltv")
  metadata            Json     @default("{}")

  project           Project            @relation(fields: [siteId], references: [id])
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  connectorInstance ConnectorInstance? @relation(fields: [connectorInstanceId], references: [id], onDelete: SetNull)
  sessions          CustomerSession[]
  events            CustomerEvent[]

  @@index([siteId], map: "idx_cust_profile_site")
  @@index([connectorInstanceId], map: "idx_cust_profile_connector")
  @@index([emailHash], map: "idx_cust_profile_email")
  @@map("customer_profiles")
}

model CustomerSession {
  id                  String    @id @db.VarChar(36)
  customerId          String    @map("customer_id") @db.VarChar(36)
  siteId              String    @map("site_id") @db.VarChar(255)
  connectorInstanceId String?   @map("connector_instance_id") @db.VarChar(36)
  startTime           DateTime  @map("start_time")
  endTime             DateTime? @map("end_time")
  durationSeconds     Int?      @map("duration_seconds")
  device              String?   @db.VarChar(100)
  browser             String?   @db.VarChar(100)
  trafficSource       String?   @map("traffic_source") @db.VarChar(255)
  isConverted         Int?      @default(0) @map("is_converted")
  eventCount          Int?      @default(0) @map("event_count")

  customer          CustomerProfile    @relation(fields: [customerId], references: [id])
  project           Project            @relation(fields: [siteId], references: [id])
  connectorInstance ConnectorInstance? @relation(fields: [connectorInstanceId], references: [id], onDelete: SetNull)
  events            CustomerEvent[]

  @@index([customerId], map: "idx_session_customer")
  @@index([siteId], map: "idx_session_site")
  @@index([connectorInstanceId], map: "idx_session_connector")
  @@map("customer_sessions")
}

model IdentityLink {
  id                  Int      @id @default(autoincrement())
  tenantId            String   @map("tenant_id") @db.VarChar(36)
  primaryCustomerId   String   @map("primary_customer_id") @db.VarChar(36)
  secondaryCustomerId String   @map("secondary_customer_id") @db.VarChar(36)
  linkType            String   @map("link_type") @db.VarChar(50)
  confidence          Decimal
  createdAt           DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("identity_links")
}

model CustomerEvent {
  id                  String   @id @db.VarChar(36)
  customerId          String   @map("customer_id") @db.VarChar(36)
  sessionId           String?  @map("session_id") @db.VarChar(36)
  siteId              String   @map("site_id") @db.VarChar(255)
  connectorInstanceId String?  @map("connector_instance_id") @db.VarChar(36)
  eventName           String   @map("event_name") @db.VarChar(255)
  category            String   @db.VarChar(50)
  timestamp           DateTime @map("timestamp")
  utmSource           String?  @map("utm_source") @db.VarChar(100)
  utmMedium           String?  @map("utm_medium") @db.VarChar(100)
  utmCampaign         String?  @map("utm_campaign") @db.VarChar(100)
  metadata            Json     @default("{}")

  customer          CustomerProfile    @relation(fields: [customerId], references: [id])
  session           CustomerSession?   @relation(fields: [sessionId], references: [id])
  project           Project            @relation(fields: [siteId], references: [id])
  connectorInstance ConnectorInstance? @relation(fields: [connectorInstanceId], references: [id], onDelete: SetNull)

  @@index([sessionId], map: "idx_cust_event_session")
  @@index([customerId, timestamp], map: "idx_cust_event_cust_ts")
  @@index([connectorInstanceId], map: "idx_cust_event_connector")
  @@map("customer_events")
}

model ConnectorInstance {
  id             String    @id @db.VarChar(36)
  siteId         String    @map("site_id") @db.VarChar(255)
  tenantId       String    @map("tenant_id") @db.VarChar(36)
  providerId     String    @map("provider_id") @db.VarChar(255)
  label          String    @db.VarChar(255)
  category       String    @db.VarChar(50)
  family         String    @db.VarChar(50)
  version        String?   @default("1.0.0") @db.VarChar(50)
  status         String    @default("DRAFT") @db.VarChar(50)
  lifecycleState String    @default("DRAFT") @map("lifecycle_state") @db.VarChar(50)
  configVersion  String?   @map("config_version") @db.VarChar(20)
  healthStatus   String    @default("HEALTHY") @map("health_status") @db.VarChar(50)
  syncConfig     Json      @default("{}") @map("sync_config")
  mappingRules   Json      @default("{}") @map("mapping_rules")
  lastSyncAt     DateTime? @map("last_sync_at")
  lastAttemptAt  DateTime? @map("last_attempt_at")
  lastWebhookAt  DateTime? @map("last_webhook_at")
  lastError      Json?     @map("last_error")
  healthScore    Int?      @default(100) @map("health_score")
  recordsByType  Json      @default("{}") @map("records_by_type")
  pixelConfig    Json?     @default("{}") @map("pixel_config")
  metadata       Json?     @default("{}") @map("metadata")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")
  disconnectedAt DateTime? @map("disconnected_at")

  project             Project                   @relation(fields: [siteId], references: [id])
  tenant              Tenant                    @relation(fields: [tenantId], references: [id])
  syncRuns            ConnectorSyncRun[]
  resyncJobs          ConnectorResyncJob[]
  credentials         ConnectorCredential[]
  lifecycleEvents     ConnectorLifecycleEvent[]
  ingestionEvents     IngestionEvent[]
  pipelineJobs        PipelineJob[]
  pipelineCheckpoints PipelineCheckpoint[]

  customerProfiles   CustomerProfile[]
  customerSessions   CustomerSession[]
  customerEvents     CustomerEvent[]
  canonicalOrders    CanonicalOrder[]
  orderSnapshots     OrderSnapshot[]
  orderEvents        OrderEvent[]
  canonicalProducts  CanonicalProduct[]
  canonicalCheckouts CanonicalCheckout[]
  auditLogs          IamAuditLog[]
  alerts             Alert[]
  alertRules         AlertRule[]
  performanceMetrics PerformanceMetric[]
  performanceRollups PerformanceRollup[]
  kpiValues          KpiValue[]
  storefrontSessions StorefrontSession[]
  storefrontEvents   StorefrontEvent[]
  storefrontErrors   StorefrontError[]
  apiHealthChecks    ConnectorHealthCheck[]
  discoveredPageUrls DiscoveredPageUrl[]

  @@index([siteId], map: "idx_connector_site")
  @@index([tenantId], map: "idx_connector_tenant")
  @@map("connector_instances")
}

model ConnectorResyncJob {
  jobId               String    @id @map("job_id") @db.VarChar(64)
  connectorInstanceId String    @map("connector_instance_id") @db.VarChar(36)
  projectId           String    @map("project_id") @db.VarChar(255)
  tenantId            String    @map("tenant_id") @db.VarChar(36)
  syncTargets         Json      @default("[]") @map("sync_targets")
  status              String    @db.VarChar(50)
  initiatedAt         DateTime  @map("initiated_at")
  completedAt         DateTime? @map("completed_at")
  error               Json?     @map("error")
  targetResults       Json?     @map("target_results")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @map("updated_at")

  connectorInstance ConnectorInstance @relation(fields: [connectorInstanceId], references: [id], onDelete: Cascade)
  project           Project           @relation(fields: [projectId], references: [id])
  tenant            Tenant            @relation(fields: [tenantId], references: [id])

  @@index([connectorInstanceId, status], map: "idx_resync_job_connector_status")
  @@index([projectId], map: "idx_resync_job_project")
  @@index([tenantId], map: "idx_resync_job_tenant")
  @@map("connector_resync_jobs")
}

model ConnectorSyncRun {
  id                  String    @id @db.VarChar(36)
  connectorInstanceId String    @map("connector_instance_id") @db.VarChar(36)
  syncType            String    @map("sync_type") @db.VarChar(50)
  status              String    @db.VarChar(50)
  startedAt           DateTime  @map("started_at")
  finishedAt          DateTime? @map("finished_at")
  recordsFetched      Int?      @default(0) @map("records_fetched")
  recordsProcessed    Int?      @default(0) @map("records_processed")
  recordsFailed       Int?      @default(0) @map("records_failed")
  checkpointValue     String?   @map("checkpoint_value") @db.Text
  errorSummary        Json?     @map("error_summary")

  connectorInstance ConnectorInstance @relation(fields: [connectorInstanceId], references: [id])

  @@index([connectorInstanceId], map: "idx_sync_run_connector")
  @@map("connector_sync_runs")
}

model ProjectAccessKey {
  id         String    @id @db.VarChar(36)
  siteId     String    @map("site_id") @db.VarChar(255)
  tenantId   String    @map("tenant_id") @db.VarChar(36)
  label      String    @db.VarChar(255)
  keyPrefix  String    @map("key_prefix") @db.VarChar(20)
  keyHash    String    @map("key_hash") @db.VarChar(255)
  status     String    @default("ACTIVE") @db.VarChar(50)
  scopes     Json      @default("[]")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String    @map("created_by") @db.VarChar(255)

  project Project @relation(fields: [siteId], references: [id])
  tenant  Tenant  @relation(fields: [tenantId], references: [id])

  @@index([siteId], map: "idx_key_site")
  @@map("project_access_keys")
}

model WebhookSubscription {
  id          String   @id @db.VarChar(36)
  siteId      String   @map("site_id") @db.VarChar(255)
  tenantId    String   @map("tenant_id") @db.VarChar(36)
  label       String   @db.VarChar(255)
  callbackUrl String   @map("callback_url") @db.Text
  secret      String   @db.VarChar(255)
  status      String   @default("ACTIVE") @db.VarChar(50)
  eventTypes  Json     @default("[]") @map("event_types")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  project Project @relation(fields: [siteId], references: [id])
  tenant  Tenant  @relation(fields: [tenantId], references: [id])

  @@index([siteId], map: "idx_webhook_sub_site")
  @@map("webhook_subscriptions")
}

model ConnectorCredential {
  id                  String    @id @db.VarChar(36)
  connectorInstanceId String    @map("connector_instance_id") @db.VarChar(36)
  tenantId            String    @map("tenant_id") @db.VarChar(36)
  projectId           String?   @map("project_id") @db.VarChar(255)
  providerId          String?   @map("provider_id") @db.VarChar(255)
  authType            String    @map("auth_type") @db.VarChar(50)
  vaultKey            String?   @map("vault_key") @db.VarChar(255)
  encryptedSecret     String?   @map("encrypted_secret") @db.Text
  expiresAt           DateTime? @map("expires_at")
  lastRotatedAt       DateTime? @map("last_rotated_at")
  scopes              Json?     @default("[]")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @map("updated_at")

  connectorInstance ConnectorInstance @relation(fields: [connectorInstanceId], references: [id], onDelete: Cascade)
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project           Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Ensure each project has only ONE active credential per provider (when both are set)
  @@unique([projectId, providerId, isActive], map: "idx_unique_project_provider_credential")
  @@index([projectId], map: "idx_credential_project")
  @@index([tenantId], map: "idx_credential_tenant")
  @@index([connectorInstanceId], map: "idx_credential_connector")
  @@map("connector_credentials")
}

model ConnectorLifecycleEvent {
  id                  String   @id @db.VarChar(36)
  connectorInstanceId String   @map("connector_instance_id") @db.VarChar(36)
  tenantId            String   @map("tenant_id") @db.VarChar(36)
  projectId           String   @map("project_id") @db.VarChar(255)

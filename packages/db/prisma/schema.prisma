// One row per store-API health probe (Backend API Observability). The
// ScheduledMonitor pings each connected store's cheapest authenticated
// endpoint and records reachability + auth validity + latency here, so the
// dashboard can show per-store up/down state, uptime %, and p95 latency over
// time. `state` is the interpreted result: healthy | auth_failed |
// unreachable | degraded. `statusCode` is the raw HTTP status (0 = no
// response: timeout / DNS / refused).
model ConnectorHealthCheck {
  id                  Int      @id @default(autoincrement())
  connectorInstanceId String   @map("connector_instance_id") @db.VarChar(36)
  siteId              String   @map("site_id") @db.VarChar(255)
  tenantId            String   @map("tenant_id") @db.VarChar(36)
  providerId          String   @map("provider_id") @db.VarChar(255)
  ok                  Boolean
  state               String   @db.VarChar(32)
  statusCode          Int      @map("status_code")
  latencyMs           Int      @map("latency_ms")
  endpoint            String?  @db.VarChar(512)
  error               String?  @db.Text
  checkedAt           DateTime @default(now()) @map("checked_at")

  connectorInstance ConnectorInstance @relation(fields: [connectorInstanceId], references: [id], onDelete: Cascade)

  @@index([siteId, checkedAt], map: "idx_apihealth_site_ts")
  @@index([connectorInstanceId, checkedAt], map: "idx_apihealth_connector_ts")
  @@map("connector_health_checks")
}


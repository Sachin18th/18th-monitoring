  correlationId       String?  @map("correlation_id") @db.VarChar(255)

  project           Project            @relation(fields: [siteId], references: [id])
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  connectorInstance ConnectorInstance? @relation(fields: [connectorInstanceId], references: [id], onDelete: SetNull)

  @@unique([siteId, metricName, source], map: "uq_perf_site_metric_source")
  @@index([siteId, metricName, timestamp], map: "idx_perf_site_name_ts")
  @@index([tenantId, timestamp], map: "idx_perf_tenant_ts")
  @@index([connectorInstanceId, timestamp], map: "idx_perf_connector_ts")
  @@map("performance_metrics")
}

